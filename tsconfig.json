{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": [
    "pages/**/*.ts",
    "support/**/*.ts",
    "step-definitions/**/*.ts",
    "features/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist", ".features-gen"]
}
